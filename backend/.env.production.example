APP_NAME=DiscountHub API
APP_VERSION=0.1.0
ENVIRONMENT=production

# Security: production must not use '*' here.
# Examples:
# CORS_ORIGINS=https://discounthub.app,https://www.discounthub.app
CORS_ORIGINS=https://your-app-domain.example

# For Docker/VPS/Render persistent volume.
DATABASE_PATH=/data/discounthub.sqlite3

# Change before deployment. Use scripts/make_admin_token.ps1 to generate one.
ADMIN_API_TOKEN=replace-with-long-random-token-at-least-32-chars

# Production hardening.
ENFORCE_PRODUCTION_SAFETY=true
ADMIN_PANEL_ENABLED=false
DOCS_ENABLED=false
OPENAPI_ENABLED=false

# Automatic feed mode.
AUTO_REGISTER_FEED_PROVIDERS=true
DEFAULT_FEED_PROVIDERS_PATH=config/feed_providers.production.example.json
DEFAULT_FEED_PROVIDERS_JSON=

FEED_SYNC_SCHEDULER_ENABLED=true
FEED_SYNC_INTERVAL_SECONDS=3600
FEED_SYNC_TIMEOUT_SECONDS=30
FEED_SYNC_RUN_ON_STARTUP=true

# eBay Browse API adapter.
# Register in eBay Developer Program, create app keys, and fill these before enabling eBay providers.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_DEFAULT_MARKETPLACE_ID=EBAY_US
EBAY_CAMPAIGN_ID=
EBAY_REFERENCE_ID=discounthub

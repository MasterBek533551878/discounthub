APP_NAME=DiscountHub API
APP_VERSION=0.1.0
ENVIRONMENT=development
CORS_ORIGINS=*
DATABASE_PATH=data/discounthub.sqlite3
ADMIN_API_TOKEN=dev-local-admin-token

# Local development keeps these enabled. Production should use .env.production.example.
ENFORCE_PRODUCTION_SAFETY=true
ADMIN_PANEL_ENABLED=true
DOCS_ENABLED=true
OPENAPI_ENABLED=true

# Automatic feed providers. This is the normal production flow.
# Put official affiliate/API/feed URLs in config/feed_providers.json or DEFAULT_FEED_PROVIDERS_JSON.
AUTO_REGISTER_FEED_PROVIDERS=true
DEFAULT_FEED_PROVIDERS_PATH=config/feed_providers.json
DEFAULT_FEED_PROVIDERS_JSON=

# Automatic feed sync scheduler.
# In production keep this enabled so products refresh automatically.
FEED_SYNC_SCHEDULER_ENABLED=true
FEED_SYNC_INTERVAL_SECONDS=3600
FEED_SYNC_TIMEOUT_SECONDS=20
FEED_SYNC_RUN_ON_STARTUP=true

# eBay Browse API adapter.
# Register in eBay Developer Program, create app keys, and fill these before enabling eBay providers.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_DEFAULT_MARKETPLACE_ID=EBAY_US
EBAY_CAMPAIGN_ID=
EBAY_REFERENCE_ID=discounthub

# Awin product-feed integration. Keep these values secret and backend-only.
# Joined Awin advertisers are imported as normal marketplaces after feed sync.
AWIN_PUBLISHER_ID=
AWIN_DATAFEED_API_KEY=
AWIN_FEED_LIST_URL=
AWIN_FEED_LIST_ENDPOINT_TEMPLATE=https://productdata.awin.com/datafeed/list/apikey/{api_key}
AWIN_FEED_MAX_FEEDS=20
AWIN_FEED_MAX_ITEMS_PER_FEED=80
AWIN_FEED_MIN_DISCOUNT_PERCENT=10

# Admitad publisher API. Keep these values secret and backend-only.
# Account settings -> API and apps -> Show credentials.
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=
ADMITAD_API_BASE_URL=https://api.admitad.com
